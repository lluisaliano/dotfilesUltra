{
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "model": "gpt-5.6-sol",
        "mode": "agent-full-access",
        "fast-mode": false
      },
      "type": "registry"
    },
    "codex": {
      "type": "registry",
      "default_config_options": {},
      "favorite_config_option_values": {},
    },
  },
  "show_signature_help_after_edits": true,
