    "selected_text": true,
    "git_diff": true,
    "show": "auto",
  },
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [
      "**/.env*",
      "**/*.pem",
      "**/*.key",
      "**/*.cert",
      "**/*.crt",
      "**/secrets.yml",
