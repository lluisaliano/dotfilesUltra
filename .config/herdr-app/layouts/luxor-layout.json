{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "column",
  "children": [
    {
      "id": "zed-titlebar",
      "type": "block",
      "content": {
        "mod": "zed-title"
      },
      "size": {
        "px": 32
      },
      "window_drag": true
    },
    {
      "id": "zed-body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "lluis-brand"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "space-groups"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "space-groups-agents"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "lluis-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 69
              }
            }
          ],
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "zed-tabs",
                "props": {
                  "hideWindowButtons": true
                }
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "zed-file-icons"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "zed-changes"
                          }
                        },
                        {
                          "id": "graph",
                          "type": "block",
                          "content": {
                            "mod": "git-graph"
                          }
                        },
                        {
                          "id": "linear",
                          "type": "block",
                          "content": {
                            "mod": "linear"
                          }
                        },
                        {
                          "id": "pr-review-assist",
                          "type": "block",
                          "content": {
                            "mod": "pr-review-assist"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "status",
              "type": "row",
              "children": [
                {
                  "id": "status-summary",
                  "type": "block",
                  "content": {
                    "mod": "lluis-status",
                    "props": {
                      "role": "summary"
                    }
                  },
                  "size": {
                    "px": 240
                  },
                  "min": 0
                },
                {
                  "id": "status-quota",
                  "type": "block",
                  "content": {
                    "mod": "zed-quota",
                    "props": {
                      "remaining": true,
                      "names": true,
                      "kinds": {
                        "session": true,
                        "weekly": true,
                        "monthly": false,
                        "model": false
                      },
                      "windows": {
                        "claude": [
                          "five_hour",
                          "seven_day"
                        ],
                        "codex": [
                          "five_hour",
                          "weekly"
                        ]
                      }
                    }
                  },
                  "size": {
                    "px": 580
                  },
                  "min": 0
                },
                {
                  "id": "status-space",
                  "type": "block",
                  "content": {
                    "mod": "lluis-status",
                    "props": {
                      "role": "spacer"
                    }
                  },
                  "size": {
                    "weight": 1
                  }
                },
                {
                  "id": "status-commands",
                  "type": "block",
                  "content": {
                    "mod": "lluis-status",
                    "props": {
                      "role": "commands"
                    }
                  },
                  "size": {
                    "px": 155
                  }
                }
              ],
              "size": {
                "px": 30
              },
              "background": "chrome"
            }
          ],
          "resizable": false
        }
      ],
      "divider": {
        "width": 1,
        "color": "border"
      }
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "paper",
    "dark": "warp-one-dark"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
